---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/dm-sans/index.css';
import '@fontsource/caveat/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Bag from '../components/Bag';
import SearchOverlay from '../components/SearchOverlay';

interface Props {
  titulo?: string;
  descripcion?: string;
  mensajeWhatsApp?: string;
  imagen?: string;
  sinFlotante?: boolean;
}

const {
  titulo,
  descripcion = 'Joyería de acero blanco y dorado, con personalidad. Elegí tu pieza y cerrá tu pedido por WhatsApp. Desde La Rioja.',
  mensajeWhatsApp = '¡Hola Midam! Tengo una consulta.',
  imagen,
  sinFlotante = false,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} | Midam Joyería` : 'Midam Joyería | La belleza de lo esencial';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#FAF6EE" />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {imagen && <meta property="og:image" content={imagen} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <slot name="head" />
    <script is:inline>
      // Guarda de dónde vino la visita para el pedido. No guarda datos personales.
      try {
        var u = new URLSearchParams(location.search).get('utm_source');
        if (u) sessionStorage.setItem('midam-origen', u);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {!sinFlotante && <WhatsAppFloat mensaje={mensajeWhatsApp} />}
    <Bag client:idle />
    <SearchOverlay client:idle />
  </body>
</html>
