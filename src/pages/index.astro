---
import Base from '../layouts/Base.astro';
import ProductCard, { IconoGiro } from '../components/ProductCard';
import Doodle from '../components/Doodle.astro';
import SpinBadge from '../components/SpinBadge.astro';
import Stripes from '../components/Stripes.astro';
import SectionHead from '../components/SectionHead.astro';
import Ticket from '../components/Ticket.astro';
import { CATEGORIAS, CONTACTO, RANGOS, enRango, formatoPrecio, numeroElenco, porCategoria, porLinea } from '../lib/catalogo';
import { leerCatalogo } from '../lib/tienda';

const { productos } = await leerCatalogo(Astro.locals);
const porNombre = (nombre: string) => productos.find((p) => p.nombre === nombre);
// Si se oculta una pieza destacada, otra toma su lugar.
const heroe = porNombre('Soraya Montenegro') ?? productos.find((p) => p.fotos.length > 1) ?? productos[0];
const fotoHeroe = heroe?.fotos[1] ?? heroe?.fotos[0];
const secundaria = porNombre('Goneril') ?? productos.find((p) => p !== heroe);
const cartelera = CATEGORIAS.map((c) => {
  const lista = porCategoria(productos, c.id);
  return { ...c, cantidad: lista.length, pieza: porNombre(c.portada) ?? lista[0] };
});
const elenco = ['Lady Macbeth', 'Rubí Pérez', 'Clea', 'Miranda Priestly', 'Silenus', 'Regina'].flatMap((n) => porNombre(n) ?? []);
const giratorias = porLinea(productos, 'giratoria').sort((a, b) => a.precio - b.precio);
const desde = giratorias[0]?.precio;
---

<Base>
  <section class="heroe">
    <div class="contenedor heroe__rejilla">
      <p class="mano heroe__nota">joyas con personalidad, desde La Rioja</p>
      <h1 class="heroe__titulo">La belleza <em>de lo</em> esencial.</h1>

      {heroe && <a class="heroe__principal" href={`/productos/${heroe.slug}`} aria-label={`${heroe.nombre}: ${heroe.descripcion}, ${formatoPrecio(heroe.precio)}`}>
        <img src={fotoHeroe!.m} srcset={`${fotoHeroe!.s} 420w, ${fotoHeroe!.m} 840w`} sizes="(min-width: 1024px) 34vw, 72vw" alt="" width="840" height="1050" fetchpriority="high" />
      </a>}
      <SpinBadge class="heroe__sello" />
      {heroe && <div class="heroe__rotulo">
        <span class="etiqueta">{numeroElenco(heroe.numero)}</span>
        <span class="heroe__personaje">{heroe.nombre}</span>
        <span class="heroe__detalle">{heroe.descripcion} · {formatoPrecio(heroe.precio)}</span>
      </div>}

      {secundaria && <a class="heroe__secundaria" href={`/productos/${secundaria.slug}`} aria-label={`${secundaria.nombre}: ${secundaria.descripcion}`}>
        <img src={secundaria.fotos[0].s} alt="" width="420" height="525" />
      </a>}

      <div class="heroe__accion">
        <div class="heroe__botones">
          <a class="boton" href="/giratorias">Conocé las que giran</a>
          <a class="boton boton--borde" href="/tienda">Ver el elenco</a>
        </div>
        <p class="heroe__bajada">Joyería de acero blanco y dorado para todos los días. Cada pieza tiene nombre propio, y algunas hasta giran.</p>
      </div>
      <Doodle tipo="flecha" tamano={56} class="heroe__flecha" />
      <Doodle tipo="destello" tamano={36} class="heroe__destello" />
    </div>
  </section>

  <section class="seccion contenedor" aria-labelledby="cartelera">
    <p class="etiqueta cartelera__acto" id="cartelera">En cartelera · {productos.length} piezas</p>
    <ul class="cartelera">
      {cartelera.map((c, i) => (
        <li>
          <a href={`/tienda/${c.id}`}>
            <span class="cartelera__indice">{String(i + 1).padStart(2, '0')}</span>
            <span class="cartelera__nombre">{c.nombre}</span>
            <span class="cartelera__cantidad">{c.cantidad}</span>
            {c.pieza && <img src={c.pieza.fotos[0].s} alt="" width="420" height="525" loading="lazy" />}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Stripes frase="WTF es salir <em>sin accesorios</em>" firma="eso, ¿qué es?" />

  <section class="seccion contenedor">
    <SectionHead acto="Primer acto" titulo="El <em>elenco</em>" bajada="Villanas, reinas y otras personalidades fuertes. Elegí a la tuya." enlace={{ href: '/tienda', texto: 'Ver las ' + productos.length }} />
    <ul class="elenco">
      {elenco.map((p, i) => (
        <li class={`elenco__celda elenco__celda--${i + 1}`}>
          <ProductCard producto={p} ancho={i === 0 || i === 3 ? '(min-width: 1024px) 40vw, 100vw' : '(min-width: 1024px) 22vw, 48vw'} />
        </li>
      ))}
    </ul>
  </section>

  <section class="giran sobre-oscuro">
    <div class="contenedor giran__rejilla">
      <div class="giran__texto">
        <p class="etiqueta">Segundo acto</p>
        <h2>Las que <em>giran.</em></h2>
        <p class="giran__bajada">Tienen una parte que se mueve con los dedos. Lindas de mirar y buenísimas para las manos inquietas.</p>
        {desde != null && <p class="mano giran__nota">desde {formatoPrecio(desde)}</p>}
        <a class="boton boton--claro" href="/giratorias">Ver cómo son</a>
      </div>
      <ul class="giran__piezas">
        {giratorias.map((p) => (
          <li>
            <a href={`/productos/${p.slug}`}>
              <span class="giran__foto">
                <img src={p.fotos[p.fotos.length > 1 ? 1 : 0].s} alt="" width="420" height="525" loading="lazy" />
                <span class="giran__icono"><IconoGiro /></span>
              </span>
              <span class="giran__nombre">{p.nombre}</span>
              <span class="giran__detalle">{p.descripcion} · {formatoPrecio(p.precio)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion contenedor">
    <SectionHead acto="Tercer acto" titulo="Para <em>regalar</em>" bajada="¿No sabés qué elegir? Empezá por cuánto querés gastar." />
    <div class="entradas">
      {RANGOS.map((r, i) => <Ticket href={`/para-regalar#${r.id}`} titulo={r.nombre} nota={r.nota} cantidad={enRango(productos, r.id).length} numero={i + 1} />)}
    </div>
  </section>

  <section class="datos">
    <ul class="contenedor datos__lista">
      <li>
        <span class="etiqueta">Cómo es la compra</span>
        <p>Armás tu pedido acá y lo cerramos por WhatsApp, con una persona real.</p>
      </li>
      <li>
        <span class="etiqueta">Cómo llega</span>
        <p>Retiro o envío a domicilio. El costo se confirma con tu pedido.</p>
      </li>
      <li>
        <span class="etiqueta">Dónde estamos</span>
        <p>{CONTACTO.ciudad}. {CONTACTO.horario}.</p>
      </li>
    </ul>
  </section>

  <section class="instagram">
    <div class="contenedor instagram__rejilla">
      <p class="instagram__frase">Cuando tu opinión sean unos aros, <em>me la das.</em></p>
      <div class="instagram__accion">
        <Doodle tipo="corazon" tamano={40} />
        <a class="boton boton--borde" href={CONTACTO.instagram} target="_blank" rel="noopener">Seguinos en {CONTACTO.usuario}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .heroe {
    position: relative;
    background: linear-gradient(var(--agua) 0 calc(14rem + 62vw), var(--papel) 0);
    overflow: hidden;
  }

  .heroe__rejilla {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--e-3);
    padding-block: var(--e-5) var(--e-6);
  }

  .heroe__nota {
    grid-column: 1 / -1;
  }

  .heroe__titulo {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    margin-top: var(--e-2);
    font-size: var(--t-display);
    line-height: 0.94;
    font-weight: 360;
    letter-spacing: -0.03em;
  }

  .heroe__titulo em {
    font-weight: 300;
  }

  .heroe__principal {
    grid-column: 2 / -1;
    grid-row: 3;
    margin-top: var(--e-3);
    border-radius: 999px 999px var(--radio) var(--radio);
    overflow: hidden;
    transition: transform var(--medio) var(--curva);
  }

  .heroe__principal img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .heroe__sello {
    grid-column: 1 / 3;
    grid-row: 3;
    align-self: start;
    z-index: 3;
    margin-top: var(--e-6);
  }

  .heroe__rotulo {
    grid-column: 2 / -1;
    display: grid;
    gap: 0.0625rem;
    margin-top: var(--e-3);
  }

  .heroe__rotulo .etiqueta {
    color: var(--oro-texto);
  }

  .heroe__personaje {
    font-family: var(--f-titulo);
    font-size: var(--t-h3);
    line-height: 1.1;
  }

  .heroe__detalle {
    color: var(--tinta-suave);
    font-size: var(--t-detalle);
  }

  .heroe__secundaria {
    display: none;
  }

  .heroe__accion {
    grid-column: 1 / -1;
    margin-top: var(--e-4);
  }

  .heroe__bajada {
    max-width: 30rem;
    margin-top: var(--e-4);
  }

  .heroe__botones {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--e-2);
  }

  .heroe__botones .boton {
    padding-inline: var(--e-2);
    font-size: 0.9375rem;
  }

  .heroe__rejilla :global(.heroe__flecha),
  .heroe__rejilla :global(.heroe__destello) {
    display: none;
  }

  @media (min-width: 1024px) {
    .heroe {
      background: linear-gradient(90deg, var(--papel) 0 58%, var(--agua) 58%);
    }

    .heroe__rejilla {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr auto;
      column-gap: var(--e-5);
      padding-block: var(--e-7);
    }

    .heroe__nota {
      grid-column: 1 / 8;
      grid-row: 1;
      font-size: 1.75rem;
    }

    .heroe__titulo {
      grid-column: 1 / 8;
      grid-row: 2;
      margin-top: var(--e-3);
    }

    .heroe__principal {
      grid-column: 8 / 13;
      grid-row: 1 / 5;
      margin-top: 0;
    }

    .heroe__principal img {
      aspect-ratio: 4 / 5;
    }

    .heroe__sello {
      grid-column: 7 / 9;
      grid-row: 3;
      align-self: center;
      justify-self: center;
      margin-top: 0;
      transform: scale(1.25);
    }

    .heroe__rotulo {
      position: absolute;
      right: calc(var(--margen) + var(--e-4));
      bottom: calc(var(--e-7) + var(--e-4));
      z-index: 3;
      padding: var(--e-3) var(--e-4);
      background: var(--papel);
      border-radius: var(--radio);
      margin-top: 0;
    }

    .heroe__secundaria {
      display: block;
      grid-column: 5 / 7;
      grid-row: 3 / 5;
      align-self: end;
      border-radius: var(--radio);
      overflow: hidden;
      transform: rotate(3deg);
      transition: transform var(--medio) var(--curva);
    }

    .heroe__secundaria:hover {
      transform: rotate(0);
    }

    .heroe__secundaria img {
      width: 100%;
      height: auto;
    }

    .heroe__accion {
      grid-column: 1 / 5;
      grid-row: 3 / 5;
      align-self: end;
      margin-top: var(--e-6);
    }

    .heroe__botones {
      grid-template-columns: 1fr;
    }

    .heroe__rejilla :global(.heroe__flecha) {
      display: block;
      position: absolute;
      left: 43%;
      top: 45%;
      color: var(--oro-texto);
      transform: rotate(-20deg);
    }

    .heroe__rejilla :global(.heroe__destello) {
      display: block;
      position: absolute;
      left: 3%;
      top: 62%;
      color: var(--rojo);
    }
  }

  .cartelera__acto {
    color: var(--oro-texto);
    margin-bottom: var(--e-3);
  }

  .cartelera {
    border-top: 1.5px solid var(--tinta);
  }

  .cartelera li {
    border-bottom: 1.5px solid var(--tinta);
  }

  .cartelera a {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem 1fr auto 3.5rem;
    align-items: center;
    gap: var(--e-3);
    padding-block: var(--e-3);
    text-decoration: none;
  }

  .cartelera__indice {
    font-size: var(--t-detalle);
    color: var(--tinta-suave);
    font-variant-numeric: tabular-nums;
  }

  .cartelera__nombre {
    font-family: var(--f-titulo);
    font-size: clamp(2.25rem, 1.4rem + 6.4vw, 6.5rem);
    line-height: 1;
    font-weight: 360;
    letter-spacing: -0.025em;
    transition: transform var(--medio) var(--curva), font-style var(--medio);
  }

  .cartelera__cantidad {
    font-size: var(--t-detalle);
    color: var(--tinta-suave);
  }

  .cartelera img {
    width: 3.5rem;
    height: 4.375rem;
    object-fit: cover;
    border-radius: 4px;
    transition: transform var(--medio) var(--curva);
  }

  @media (min-width: 1024px) {
    .cartelera a {
      grid-template-columns: 3rem 1fr auto 7rem;
      padding-block: var(--e-3);
    }

    .cartelera img {
      width: 7rem;
      height: 7rem;
    }
  }

  @media (hover: hover) {
    .cartelera a:hover .cartelera__nombre {
      transform: translateX(var(--e-4));
      font-style: italic;
    }

    .cartelera a:hover img {
      transform: scale(1.06) rotate(-2deg);
    }
  }

  .elenco {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-5) var(--e-3);
  }

  .elenco__celda--1,
  .elenco__celda--4 {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .elenco {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--e-6) var(--e-5);
    }

    .elenco__celda--1 {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
    }

    .elenco__celda--2 {
      grid-column: 6 / 9;
      margin-top: var(--e-8);
    }

    .elenco__celda--3 {
      grid-column: 9 / 13;
    }

    .elenco__celda--4 {
      grid-column: 8 / 13;
      grid-row: 2 / 4;
    }

    .elenco__celda--5 {
      grid-column: 1 / 4;
      grid-row: 3;
    }

    .elenco__celda--6 {
      grid-column: 4 / 8;
      grid-row: 3;
      margin-top: calc(var(--e-8) * -1);
    }
  }

  .giran {
    background: var(--tinta-honda);
    color: var(--papel);
    padding-block: var(--e-8);
  }

  .giran__rejilla {
    display: grid;
    gap: var(--e-6);
  }

  .giran__texto .etiqueta {
    color: var(--agua);
  }

  .giran h2 {
    margin-top: var(--e-2);
    font-size: var(--t-display);
    font-weight: 340;
    line-height: 0.96;
  }

  .giran h2 em {
    color: var(--agua);
  }

  .giran__bajada {
    max-width: 28rem;
    margin-top: var(--e-5);
  }

  .giran__nota {
    margin-block: var(--e-3) var(--e-4);
    color: var(--agua);
  }

  .giran__piezas {
    display: flex;
    gap: var(--e-3);
    margin-inline: calc(var(--margen) * -1);
    padding-inline: var(--margen);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .giran__piezas::-webkit-scrollbar {
    display: none;
  }

  .giran__piezas li {
    flex: 0 0 68%;
    scroll-snap-align: center;
  }

  .giran__piezas a {
    display: grid;
    gap: 0.125rem;
    text-decoration: none;
  }

  .giran__foto {
    position: relative;
    display: block;
    border-radius: var(--radio);
    overflow: hidden;
    margin-bottom: var(--e-2);
  }

  .giran__foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .giran__icono {
    position: absolute;
    right: var(--e-2);
    top: var(--e-2);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--papel);
    color: var(--tinta-honda);
    transition: transform 600ms var(--curva);
  }

  .giran__piezas a:hover .giran__icono {
    transform: rotate(360deg);
  }

  .giran__nombre {
    font-family: var(--f-titulo);
    font-size: var(--t-h3);
  }

  .giran__detalle {
    font-size: var(--t-detalle);
    color: var(--agua-suave);
  }

  @media (min-width: 1024px) {
    .giran {
      padding-block: var(--e-9);
    }

    .giran__rejilla {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: var(--e-7);
    }

    .giran__piezas {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      gap: var(--e-4);
    }

    .giran__piezas li {
      flex: 1;
    }

    .giran__piezas li:nth-child(2) {
      margin-top: var(--e-7);
    }
  }

  .entradas {
    display: grid;
    gap: var(--e-3);
  }

  @media (min-width: 900px) {
    .entradas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-4);
    }
  }

  .datos {
    border-block: 1.5px solid var(--tinta);
  }

  .datos__lista {
    display: grid;
    gap: var(--e-4);
    padding-block: var(--e-5);
  }

  .datos__lista .etiqueta {
    color: var(--oro-texto);
  }

  .datos__lista p {
    margin-top: var(--e-1);
  }

  @media (min-width: 768px) {
    .datos__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-6);
    }
  }

  .instagram {
    background: var(--tornasol);
    padding-block: var(--e-8);
  }

  .instagram__rejilla {
    display: grid;
    gap: var(--e-5);
  }

  .instagram__frase {
    font-family: var(--f-titulo);
    font-size: var(--t-h1);
    line-height: 1.02;
    font-weight: 380;
    max-width: 18ch;
  }

  .instagram__accion {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--e-3);
    color: var(--rojo);
  }

  .instagram__accion .boton {
    color: var(--tinta);
  }

  .instagram__accion .boton:hover {
    color: var(--papel);
  }

  @media (min-width: 900px) {
    .instagram__rejilla {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
