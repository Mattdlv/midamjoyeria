---
import { crearProducto, leerFormProducto } from '../../../lib/admin-catalogo';
import FormProducto from '../../../components/FormProducto.astro';
import { env } from '../../../lib/entorno';
import Admin from '../../../layouts/Admin.astro';

const usuario = Astro.locals.usuario;
if (!usuario) return new Response('No autorizado', { status: 403 });

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const r = leerFormProducto(f);
  const stock = String(f.get('stock') ?? '').trim();
  if (!r.ok) return Astro.redirect(`/admin/productos/nuevo?aviso=${r.error}`, 303);
  if (!/^\d+$/.test(stock)) return Astro.redirect('/admin/productos/nuevo?aviso=monto', 303);
  const id = await crearProducto(env.DB, r.datos, Number(stock), usuario);
  return Astro.redirect(`/admin/productos/${id}?aviso=creado`, 303);
}
---

<Admin titulo="Nuevo producto" seccion="stock">
  <a class="tarjeta-pedido__detalle" href="/admin/stock">← Productos</a>
  <h1 style="margin-bottom: var(--e-4)">Nuevo producto</h1>
  <form class="bloque form-panel" method="post">
    <FormProducto>
      <div class="campo" slot="stock">
        <label for="stock">Stock inicial</label>
        <input id="stock" name="stock" inputmode="numeric" pattern="[0-9]+" required value="1" />
      </div>
    </FormProducto>
    <button class="boton" type="submit">Crear y seguir con las fotos</button>
    <p class="campo__ayuda">El producto aparece en la tienda cuando tiene al menos una foto.</p>
  </form>
</Admin>
