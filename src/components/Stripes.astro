---
// Bloque de rayas azules con un detalle rojo, como las gráficas del feed.
interface Props {
  frase: string;
  firma?: string;
}
const { frase, firma } = Astro.props;
---

<section class="rayas">
  <div class="rayas__cartel">
    <span class="rayas__punto" aria-hidden="true"></span>
    <p class="rayas__frase" set:html={frase} />
    {firma && <p class="mano rayas__firma">{firma}</p>}
  </div>
</section>

<style>
  .rayas {
    padding: var(--e-7) var(--margen);
    background: repeating-linear-gradient(90deg, var(--mar) 0 22px, #d8ecff 22px 44px);
    overflow: hidden;
  }

  .rayas__cartel {
    position: relative;
    max-width: 46rem;
    margin-inline: auto;
    padding: var(--e-6) var(--e-5);
    background: var(--papel);
    border-radius: var(--radio);
    transform: rotate(-1.5deg);
    box-shadow: 0 2px 0 var(--rojo);
    text-align: center;
  }

  .rayas__punto {
    position: absolute;
    left: 50%;
    top: -0.625rem;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: -0.625rem;
    border-radius: 50%;
    background: var(--rojo);
  }

  .rayas__frase {
    font-family: var(--f-titulo);
    font-size: clamp(2.25rem, 1.2rem + 5vw, 4.75rem);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .rayas__firma {
    margin-top: var(--e-3);
    color: var(--oro-texto);
  }
</style>
