---
// Sello de texto circular que gira, en referencia a la línea giratoria.
interface Props {
  texto?: string;
  class?: string;
}
const { texto = 'gira · gira · gira · gira · ', class: clase } = Astro.props;
const id = 'circulo-' + Math.random().toString(36).slice(2, 8);
---

<span class:list={['sello', clase]} aria-hidden="true">
  <svg viewBox="0 0 100 100" class="sello__texto">
    <defs><path id={id} d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0"></path></defs>
    <text><textPath href={`#${id}`} textLength="228">{texto}</textPath></text>
  </svg>
  <svg class="sello__centro" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"></path><path d="M20 3v4h-4"></path></svg>
</span>

<style>
  .sello {
    position: relative;
    display: grid;
    place-items: center;
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 50%;
    background: var(--tinta);
    color: var(--papel);
  }

  .sello__texto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: girar 14s linear infinite;
  }

  .sello__texto text {
    fill: currentColor;
    font-family: var(--f-mano);
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }

  .sello__texto {
    transform-origin: 50% 50%;
  }
</style>
