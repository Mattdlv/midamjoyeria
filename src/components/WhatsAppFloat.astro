---
import { enlaceWhatsApp } from '../lib/catalogo';

interface Props {
  mensaje: string;
}
const { mensaje } = Astro.props;
---

<a class="flotante" href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.8-.4-2.1-1-3.2-2.8-.1-.2 0-.4.1-.5l.4-.4.2-.4c.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.7 3 .6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.3-.3-.3-.5-.5Z"></path>
  </svg>
</a>

<style>
  .flotante {
    position: fixed;
    z-index: 30;
    right: var(--margen);
    bottom: calc(var(--e-4) + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--agua);
    color: var(--tinta-honda);
    border: 1.5px solid var(--tinta);
    transition: transform var(--rapido) var(--curva);
  }

  .flotante:hover {
    transform: translateY(-2px) rotate(-6deg);
  }

  :global(body:has(.barra-compra--visible)) .flotante {
    bottom: calc(5.25rem + env(safe-area-inset-bottom));
  }

  @media (min-width: 1024px) {
    :global(body:has(.barra-compra--visible)) .flotante {
      bottom: calc(var(--e-4) + env(safe-area-inset-bottom));
    }
  }
</style>
